### 8. 保存接口：proc_emp_query，IN可选条件 + OUT游标 + OUT标量
POST {{baseUrl}}/api/interface/save
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "name": "员工列表游标查询",
  "code": "{{apiEmpQuery}}",
  "type": 2,
  "description": "测试OUT SYS_REFCURSOR和可选过滤条件",
  "orderNo": 103,
  "connectionId": {{connectionId}},
  "fieldBackMode": 1,
  "page": 0,
  "procedureName": "proc_emp_query",
  "apiParamList": [
    {
      "name": "部门ID",
      "code": "deptId",
      "type": 3,
      "direction": 1,
      "jdbcType": "DECIMAL",
      "orderNo": 1,
      "required": 0,
      "defaultValue": null,
      "validateType": 1
    },
    {
      "name": "最低薪资",
      "code": "minSalary",
      "type": 3,
      "direction": 1,
      "jdbcType": "DECIMAL",
      "orderNo": 2,
      "required": 0,
      "defaultValue": null,
      "validateType": 1
    },
    {
      "name": "状态码",
      "code": "status",
      "direction": 2,
      "jdbcType": "VARCHAR",
      "orderNo": 3
    },
    {
      "name": "状态说明",
      "code": "message",
      "direction": 2,
      "jdbcType": "VARCHAR",
      "orderNo": 4
    },
    {
      "name": "员工列表",
      "code": "data",
      "direction": 2,
      "jdbcType": "CURSOR",
      "orderNo": 5
    }
  ]
}


### 9. 执行：proc_emp_query，按部门过滤
### 预期：cursors.data 返回 dept_id=10 的张三、李四
POST {{baseUrl}}/api/actuator/execute
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "apiCode": "{{apiEmpQuery}}",
  "token": "{{token}}",
  "systemCode": "{{systemCode}}",
  "params": {
    "deptId": 10
  }
}


### 10. 执行：proc_emp_query，部门 + 最低薪资
### 预期：cursors.data 返回 dept_id=10 且 salary>=6000 的李四
POST {{baseUrl}}/api/actuator/execute
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "apiCode": "{{apiEmpQuery}}",
  "token": "{{token}}",
  "systemCode": "{{systemCode}}",
  "params": {
    "deptId": 10,
    "minSalary": 6000
  }
}


