### 14. 保存接口：proc_emp_insert，DML插入
POST {{baseUrl}}/api/interface/save
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "name": "新增员工过程",
  "code": "{{apiEmpInsert}}",
  "type": 2,
  "description": "测试存储过程内部DML和异常返回",
  "orderNo": 104,
  "connectionId": {{connectionId}},
  "fieldBackMode": 1,
  "page": 0,
  "procedureName": "proc_emp_insert",
  "apiParamList": [
    {"name": "员工ID", "code": "empId", "type": 2, "direction": 1, "jdbcType": "DECIMAL", "orderNo": 1, "required": 1, "validateType": 1},
    {"name": "员工姓名", "code": "empName", "type": 1, "direction": 1, "jdbcType": "VARCHAR", "orderNo": 2, "required": 1, "validateType": 1},
    {"name": "薪资", "code": "salary", "type": 3, "direction": 1, "jdbcType": "DECIMAL", "orderNo": 3, "required": 1, "validateType": 1},
    {"name": "部门ID", "code": "deptId", "type": 2, "direction": 1, "jdbcType": "DECIMAL", "orderNo": 4, "required": 1, "validateType": 1},
    {"name": "状态码", "code": "status", "direction": 2, "jdbcType": "VARCHAR", "orderNo": 5},
    {"name": "状态说明", "code": "message", "direction": 2, "jdbcType": "VARCHAR", "orderNo": 6}
  ]
}


### 15. 执行：proc_emp_insert，新增成功
### 预期：status=0，message=insert success
POST {{baseUrl}}/api/actuator/execute
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "apiCode": "{{apiEmpInsert}}",
  "token": "{{token}}",
  "systemCode": "{{systemCode}}",
  "params": {
    "empId": 100,
    "empName": "测试员工",
    "salary": 8800,
    "deptId": 40
  }
}


