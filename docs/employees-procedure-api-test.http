### 18. 保存接口：proc_emp_raise_salary，更新过程
POST {{baseUrl}}/api/interface/save
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "name": "按部门涨薪过程",
  "code": "{{apiEmpRaiseSalary}}",
  "type": 2,
  "description": "测试更新类DML过程和OUT影响行数",
  "orderNo": 105,
  "connectionId": {{connectionId}},
  "fieldBackMode": 1,
  "page": 0,
  "procedureName": "proc_emp_raise_salary",
  "apiParamList": [
    {"name": "部门ID", "code": "deptId", "type": 2, "direction": 1, "jdbcType": "DECIMAL", "orderNo": 1, "required": 1, "validateType": 1},
    {"name": "涨薪比例", "code": "raiseRate", "type": 3, "direction": 1, "jdbcType": "DECIMAL", "orderNo": 2, "required": 1, "validateType": 1},
    {"name": "影响行数", "code": "rows", "direction": 2, "jdbcType": "DECIMAL", "orderNo": 3},
    {"name": "状态码", "code": "status", "direction": 2, "jdbcType": "VARCHAR", "orderNo": 4},
    {"name": "状态说明", "code": "message", "direction": 2, "jdbcType": "VARCHAR", "orderNo": 5}
  ]
}


### 19. 执行：proc_emp_raise_salary
### 预期：deptId=20 的王五、赵六涨薪10%，rows=2
POST {{baseUrl}}/api/actuator/execute
Content-Type: application/json

{
  "tenant": "{{tenant}}",
  "apiCode": "{{apiEmpRaiseSalary}}",
  "token": "{{token}}",
  "systemCode": "{{systemCode}}",
  "params": {
    "deptId": 20,
