{
  "tenant": "{{tenant}}",
  "apiCode": "{{apiEmpInsert}}",
  "token": "{{token}}",
  "systemCode": "{{systemCode}}",
  "params": {
    "empId": 1,
    "empName": "重复员工",
    "salary": 6600,
    "deptId": 10
  }
}


